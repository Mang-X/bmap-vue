{
  "name": "docs-site",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vitepress dev .",
    "build": "vitepress build .",
    "preview": "vitepress preview .",
    "format": "vp fmt . --write --ignore-path .prettierignore",
    "format:check": "vp fmt . --check --ignore-path .prettierignore",
    "lint": "vp lint . --vue-plugin --node-plugin --import-plugin",
    "typecheck": "vp exec vue-tsc -p tsconfig.json --noEmit",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck",
    "lint:zh": "pnpm zhlint '**/*.md' --fix"
  },
  "dependencies": {
    "@vueuse/core": "^14.4.0",
    "bmap-draw": "^1.0.19",
    "prism-theme-vars": "^0.2.5",
    "three": "^0.158.0",
    "vitepress": "2.0.0-alpha.20"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@vite-pwa/vitepress": "^1.1.0",
    "bmap-vue": "workspace:*",
    "chalk": "^4.1.2",
    "consola": "^2.15.3",
    "escape-html": "^1.0.3",
    "less": "^4.1.3",
    "markdown-it": "^14.1.0",
    "markdown-it-container": "^4.0.0",
    "prismjs": "^1.29.0",
    "typescript": "^5.9.0",
    "vanilla-tilt": "^1.8.0",
    "vite-plugin-pwa": "^1.3.0",
    "vue-tsc": "^3.3.11",
    "workbox-window": "^7.4.1",
    "zhlint": "^0.8.2"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
