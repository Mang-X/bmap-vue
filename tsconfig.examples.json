{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "baseUrl": ".",
    "paths": {
      "bmap-vue": [
        "packages/bmap-vue/src/index.ts"
      ],
      "bmap-vue/*": [
        "packages/bmap-vue/src/*"
      ]
    }
  },
  "include": [
    "docs/examples/**/*.vue",
    "docs/env.d.ts"
  ]
}