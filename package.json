{
  "name": "bmap-vue-workspace",
  "description": "A Vue 3 component and hooks library for Baidu Maps JavaScript API 4.0.",
  "version": "1.0.0-rc.0",
  "scripts": {
    "build:package": "node --experimental-strip-types scripts/build-package.mts",
    "changeset": "changeset",
    "check:165-coverage": "node --experimental-strip-types scripts/check-165-coverage.mts",
    "check:api": "node --experimental-strip-types scripts/check-api.mts",
    "check:brand-icons": "node --experimental-strip-types scripts/check-brand-icons.mts",
    "check:comment-hygiene": "node --experimental-strip-types scripts/check-comment-hygiene.mts",
    "check:component-catalog": "node --experimental-strip-types scripts/check-component-catalog.mts",
    "check:doc-props": "node --experimental-strip-types scripts/check-doc-props.mts",
    "check:docs-brand": "node --experimental-strip-types scripts/check-docs-brand.mts",
    "check:docs-links": "node --experimental-strip-types scripts/check-docs-links.mts",
    "check:dts-strict": "node --experimental-strip-types scripts/check-dts-strict.mts",
    "check:interaction-props": "node --experimental-strip-types scripts/check-interaction-props.mts",
    "check:pack-contents": "node --experimental-strip-types scripts/check-pack-contents.mts",
    "check:package-shape": "node --experimental-strip-types scripts/check-package-shape.mts",
    "check:props-projected": "node --experimental-strip-types scripts/check-props-projected.mts",
    "check:public-dts": "node --experimental-strip-types scripts/check-public-dts.mts",
    "check:raw-sdk": "node --experimental-strip-types scripts/check-raw-sdk.mts",
    "check:raw-sdk:declarations": "node --experimental-strip-types scripts/check-raw-sdk.mts --declarations packages/bmap-vue/dist",
    "check:raw-sdk:tree": "node --experimental-strip-types scripts/check-raw-sdk.mts --src packages/bmap-vue/src",
    "check:snippet-consistency": "node --experimental-strip-types scripts/check-snippet-consistency.mts",
    "check:toolchain": "node --experimental-strip-types scripts/check-toolchain.mts",
    "docs:build": "vp run --filter ./docs build",
    "docs:check": "vp run --filter ./docs check",
    "docs:dev": "vp run --filter ./docs dev",
    "docs:format": "vp run --filter ./docs format",
    "docs:format:check": "vp run --filter ./docs format:check",
    "docs:lint": "vp run --filter ./docs lint",
    "docs:typecheck": "vp run --filter ./docs typecheck",
    "generate:165-coverage": "node --experimental-strip-types scripts/generate-165-coverage.mts",
    "generate:api": "node --experimental-strip-types scripts/check-api.mts --local",
    "generate:api-diff": "node --experimental-strip-types scripts/generate-api-diff.mts",
    "generate:api-diff:check": "node --experimental-strip-types scripts/generate-api-diff.mts --check",
    "generate:brand-icons": "node --experimental-strip-types scripts/render-brand-icons.mts",
    "generate:capability-matrix": "node --experimental-strip-types scripts/generate-capability-matrix.mts",
    "generate:capability-matrix:check": "node --experimental-strip-types scripts/generate-capability-matrix.mts --check",
    "generate:manifest": "node --experimental-strip-types scripts/generate-manifest-artifacts.mts",
    "generate:manifest:check": "node --experimental-strip-types scripts/generate-manifest-artifacts.mts --check",
    "generate:overlay-emits": "node --experimental-strip-types scripts/generate-overlay-emits.mts",
    "generate:overlay-emits:check": "node --experimental-strip-types scripts/generate-overlay-emits.mts --check",
    "generate:plugin-inventory": "node --experimental-strip-types scripts/generate-plugin-inventory.mts",
    "generate:plugin-inventory:check": "node --experimental-strip-types scripts/generate-plugin-inventory.mts --check",
    "generate:screenshots": "node --experimental-strip-types scripts/capture-docs-screenshots.mts",
    "pack:package": "node --experimental-strip-types scripts/pack-package.mts",
    "perf:baseline": "node --experimental-strip-types scripts/collect-performance-baseline.mts",
    "perf:baseline:live": "node --experimental-strip-types scripts/collect-live-performance.mts",
    "playground:build": "pnpm --filter playground build",
    "playground:dev": "vp run -C apps/playground dev",
    "probe:165-feature-layer": "node --experimental-strip-types scripts/probe-165-feature-layer.mts",
    "probe:165-level-effect": "node --experimental-strip-types scripts/probe-165-level-effect.mts",
    "probe:destroy-idempotency": "node --experimental-strip-types scripts/probe-destroy-idempotency.mts",
    "probe:jsonp-callback": "node --experimental-strip-types scripts/probe-jsonp-callback.mts",
    "probe:layer-detached": "node --experimental-strip-types scripts/probe-layer-detached.mts",
    "probe:layer-events": "node --experimental-strip-types scripts/probe-layer-events.mts",
    "probe:mvt-layer": "node --experimental-strip-types scripts/probe-mvt-layer.mts",
    "probe:native-point-cluster": "node --experimental-strip-types scripts/probe-native-point-cluster.mts",
    "probe:official": "node --experimental-strip-types scripts/probe-official-packages.mts",
    "probe:plugin-compat": "node --experimental-strip-types scripts/probe-plugin-compat.mts",
    "probe:plugin-load-channel": "node --experimental-strip-types scripts/probe-plugin-load-channel.mts",
    "probe:plugin-runtime": "node --experimental-strip-types scripts/probe-plugin-runtime.mts",
    "probe:point-pick": "node --experimental-strip-types scripts/probe-point-pick.mts",
    "probe:track-line": "node --experimental-strip-types scripts/probe-track-line.mts",
    "skills:install": "npx -y skills experimental_install -y",
    "skills:list": "npx -y skills list",
    "smoke:v4": "node --experimental-strip-types scripts/smoke-jsapi-v4.mts --mode=live",
    "smoke:v4:fixture": "node --experimental-strip-types scripts/smoke-jsapi-v4.mts --mode=fixture",
    "test:performance": "vitest run --config tests/performance/vitest.config.ts",
    "test:unit": "node --experimental-strip-types scripts/generate-manifest-artifacts.mts --check && vitest run tests/behavior tests/__smoke__.test.ts packages",
    "typecheck:package": "pnpm exec vue-tsc -p packages/bmap-vue/tsconfig.build.json",
    "typecheck:tests": "vue-tsc -p tsconfig.tests.json",
    "typecheck:type-contracts": "vue-tsc -p tsconfig.type-contracts.json",
    "verify:package": "node --experimental-strip-types scripts/verify-package.mts"
  },
  "dependencies": {
    "mitt": "^3.0.0",
    "vue": "^3.5.0"
  },
  "peerDependencies": {
    "vue": "^3.0.0"
  },
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=12.0.0"
  },
  "private": true,
  "packageManager": "pnpm@12.0.0",
  "author": "MangMax",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Mang-X/bmap-vue.git"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@baidumap/jsapi-loader": "1.0.0",
    "@baidumap/jsapi-ui-kit": "1.1.2",
    "@changesets/cli": "^3.0.2",
    "@types/node": "^26.4.1",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/test-utils": "^2.5.0",
    "@vueuse/core": "14.4.0",
    "happy-dom": "^20.14.0",
    "jsdom": "^30.0.1",
    "publint": "0.3.24",
    "typescript": "^5.9.0",
    "unplugin-vue": "^7.2.0",
    "unplugin-vue-components": "^32.1.0",
    "vite": "^8.2.2",
    "vite-plus": "0.3.0",
    "vitest": "^5.0.0",
    "vue-tsc": "^2.2.0"
  }
}
