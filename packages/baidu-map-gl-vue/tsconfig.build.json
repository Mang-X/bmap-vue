{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "declaration": true,
    "emitDeclarationOnly": true,
    "declarationDir": "./dist/dts",
    "skipLibCheck": false,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "types": ["vite/client", "@baidumap/jsapi-v4-types"],
    "paths": {
      "mitt": ["../../node_modules/mitt/index.d.ts"],
      "@baidumap/jsapi-ui-kit": ["./types/ui-kit/upstream.d.ts"]
    }
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.vue",
    "src/**/*.d.ts",
    "types/**/*.d.ts"
  ],
  "exclude": ["src/**/*.test.ts", "src/**/__tests__/**", "node_modules"]
}
