{
  "name": "bmap-vue",
  "description": "Vue 3 components and hooks for Baidu Maps JavaScript API 4.0.",
  "version": "1.0.0-rc.0",
  "type": "module",
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "unpkg": "./dist/index.global.js",
  "jsdelivr": "./dist/index.global.js",
  "style": "./dist/bmap-vue.css",
  "private": false,
  "license": "MIT",
  "keywords": [
    "vue",
    "vue3",
    "baidu-map",
    "baidu-maps",
    "bmap",
    "jsapi",
    "map"
  ],
  "homepage": "https://github.com/Mang-X/bmap-vue#readme",
  "bugs": {
    "url": "https://github.com/Mang-X/bmap-vue/issues"
  },
  "sideEffects": false,
  "files": [
    "dist",
    "volar.d.ts",
    "README.md",
    "NOTICE.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs"
    },
    "./components": {
      "types": "./dist/components.d.ts",
      "import": "./dist/components.mjs"
    },
    "./composables": {
      "types": "./dist/composables.d.ts",
      "import": "./dist/composables.mjs"
    },
    "./plugins": {
      "types": "./dist/plugins.d.ts",
      "import": "./dist/plugins.mjs"
    },
    "./resolver": {
      "types": "./dist/resolver.d.ts",
      "import": "./dist/resolver.mjs"
    },
    "./advanced": {
      "types": "./dist/advanced.d.ts",
      "import": "./dist/advanced.mjs"
    },
    "./ui-kit": {
      "types": "./dist/ui-kit.d.ts",
      "import": "./dist/ui-kit.mjs"
    },
    "./package.json": "./package.json"
  },
  "peerDependencies": {
    "@baidumap/jsapi-ui-kit": "1.1.2",
    "vue": "^3.5.0"
  },
  "peerDependenciesMeta": {
    "@baidumap/jsapi-ui-kit": {
      "optional": true
    }
  },
  "dependencies": {
    "@baidumap/jsapi-loader": "1.0.0",
    "@vueuse/core": "14.4.0"
  },
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "@baidumap/jsapi-v4-types": "4.0.4",
    "@microsoft/api-extractor": "^7.52.0",
    "@types/web-bluetooth": "0.0.21",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/language-core": "^2.2.0",
    "typescript": "^5.8.3",
    "vite": "^8.2.2",
    "vite-plugin-dts": "^5.1.0",
    "vue-tsc": "^2.2.0"
  },
  "author": "MangMax",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Mang-X/bmap-vue.git"
  }
}
